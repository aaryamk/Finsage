{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=5000 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/finsage run build",
  "outputDirectory": "artifacts/finsage/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
